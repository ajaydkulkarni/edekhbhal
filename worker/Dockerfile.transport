FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY worker ./worker

# Probe-only image retained for identity/capability verification. The production
# 03B2 image is worker/Dockerfile and includes FFmpeg plus the real queue loop.
CMD ["node","worker/evidence-worker.mjs","--probe"]
