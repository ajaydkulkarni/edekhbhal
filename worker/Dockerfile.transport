FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY worker ./worker

# 03B1 is a transport/probe image only. Foundation 03B2 adds the production
# processing loop plus image/video codecs.
CMD ["node","worker/evidence-worker.mjs","--probe"]
