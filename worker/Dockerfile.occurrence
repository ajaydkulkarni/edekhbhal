FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      dumb-init \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./

RUN npm ci --omit=dev

COPY worker ./worker

# Normalize source permissions so the unprivileged runtime user can
# traverse/read worker code regardless of host workspace ACLs.
RUN find /app/worker -type d -exec chmod 755 {} + \
 && find /app/worker -type f -exec chmod 644 {} +

USER node

HEALTHCHECK \
  --interval=30s \
  --timeout=20s \
  --start-period=20s \
  --retries=3 \
  CMD ["node","worker/occurrence-generation-worker.mjs","--health-check"]

ENTRYPOINT ["dumb-init","--"]

CMD ["node","worker/occurrence-generation-worker.mjs","--run"]
