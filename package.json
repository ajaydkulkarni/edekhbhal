{
  "name": "operations-platform-vnext",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:module": "vitest run tests/module",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:foundation": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:foundation:apply": "node scripts/db-apply-foundation-01.mjs",
    "db:foundation:seed": "node scripts/db-seed-foundation-01.mjs",
    "db:foundation": "npm run db:foundation:apply && npm run db:foundation:seed",
    "db:privileges:harden": "node scripts/db-apply-privilege-hardening-02.mjs",
    "db:onboarding:apply": "node scripts/db-apply-auth-onboarding-03.mjs",
    "db:work-area-qr:apply": "node scripts/db-apply-work-area-qr-04.mjs",
    "db:work-area-qr:hotfix": "node scripts/db-apply-work-area-qr-token-hotfix-05.mjs",
    "db:work-area-qr:harden": "node scripts/db-apply-work-area-qr-hardening-06.mjs",
    "db:task-master:apply": "node scripts/db-apply-task-master-07.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
