# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only pooled PostgreSQL URL for the runtime role.
# Do not put this in NEXT_PUBLIC_*.
DATABASE_URL=

# Direct database URL used only for migrations/admin tooling.
# Keep separate from the runtime connection.
MIGRATION_DATABASE_URL=

# Product-neutral branding
NEXT_PUBLIC_PRODUCT_NAME=Operations Platform
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Tests
TEST_DATABASE_URL=
